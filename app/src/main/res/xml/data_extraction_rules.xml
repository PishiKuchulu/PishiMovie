<?xml version="1.0" encoding="utf-8"?>
<!--
  PishiMovie data-extraction rules (API 31+).

  Mirrors backup_rules.xml: files that reveal viewing/search behavior or
  embed streaming source URLs are excluded from cloud backup AND from
  device-to-device transfer. Pure UI preferences (theme via DataStore, font,
  player/subtitle settings) stay included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <!-- Viewing / search / download behavior -->
        <exclude domain="file" path="continue_watching.json"/>
        <exclude domain="file" path="watch_sessions.json"/>
        <exclude domain="file" path="watched_episodes.json"/>
        <exclude domain="file" path="search_history.json"/>
        <exclude domain="file" path="download_history.json"/>
        <!-- Favorites / watchlist / ratings (embed streaming source URLs) -->
        <exclude domain="file" path="favorites.json"/>
        <exclude domain="file" path="favorite_groups.json"/>
        <exclude domain="file" path="watchlist.json"/>
        <exclude domain="file" path="user_ratings.json"/>
        <!-- Per-video subtitle overrides (keyed by full video URLs) -->
        <exclude domain="file" path="subtitle_per_video.json"/>
        <!-- Cached metadata / detail files (re-fetchable) -->
        <exclude domain="file" path="pishi_metadata_cache/"/>
        <exclude domain="file" path="detail_cache/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
        <!-- Viewing / search / download behavior -->
        <exclude domain="file" path="continue_watching.json"/>
        <exclude domain="file" path="watch_sessions.json"/>
        <exclude domain="file" path="watched_episodes.json"/>
        <exclude domain="file" path="search_history.json"/>
        <exclude domain="file" path="download_history.json"/>
        <!-- Favorites / watchlist / ratings (embed streaming source URLs) -->
        <exclude domain="file" path="favorites.json"/>
        <exclude domain="file" path="favorite_groups.json"/>
        <exclude domain="file" path="watchlist.json"/>
        <exclude domain="file" path="user_ratings.json"/>
        <!-- Per-video subtitle overrides (keyed by full video URLs) -->
        <exclude domain="file" path="subtitle_per_video.json"/>
        <!-- Cached metadata / detail files (re-fetchable) -->
        <exclude domain="file" path="pishi_metadata_cache/"/>
        <exclude domain="file" path="detail_cache/"/>
    </device-transfer>
</data-extraction-rules>
