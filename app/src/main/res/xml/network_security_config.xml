<?xml version="1.0" encoding="utf-8"?>
<!--
  PishiMovie network security config.

  Cleartext (HTTP) is PERMITTED app-wide since v1.4.3. History: up to
  v1.4.2 it was allowed only for the three known backend hosts — but the
  backend hands out stream URLs as plain http on rotating CDN hosts
  (dl*.info / *.ir families) that no static allowlist can enumerate, so
  the platform blocked every playback request in-process
  (ERROR_CODE_IO_CLEARTEXT_NOT_PERMITTED) and no video played at all.
  Permitting cleartext is a capability, not a downgrade: the API base
  URLs are https, so API traffic stays on TLS exactly as before; only
  the backend-issued stream URLs use http, as they do in a browser.

  NOTE (pinning): certificate pinning for the three backend hosts is
  intentionally NOT enabled yet. A pin-set was specified for this release,
  but the supplied pin value was verified to be the SHA-256 of the empty
  string (a placeholder, not a real SPKI pin) — installing it would reject
  the backends' real certificates and break all API calls. To enable pinning,
  obtain the real SPKI pins on a machine with direct TLS access, e.g.:

      openssl s_client -connect server-hi-speed-iran.info:443 -servername server-hi-speed-iran.info \
        | openssl x509 -pubkey -noout \
        | openssl pkey -pubin -outform der \
        | openssl dgst -sha256 -binary | openssl base64

  then add inside the <domain-config> below:

      <pin-set expiration="2028-01-01">
          <pin digest="SHA-256">BASE64-SPKI-PIN-HERE</pin>
      </pin-set>
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Backend hosts (API + helper servers): cleartext allowed, as
         everywhere else since v1.4.3 — kept explicit for the future
         pin-set below, which applies to these hosts only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">server-hi-speed-iran.info</domain>
        <domain includeSubdomains="true">hostinnegar.com</domain>
        <domain includeSubdomains="true">windowsdiba.info</domain>
    </domain-config>

    <!-- Debug overrides: trust user CAs (e.g. Charles / mitmproxy) for
         development only. Has no effect in release builds. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
