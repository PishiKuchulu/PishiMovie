<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet and network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ExoPlayer wake lock (required by setWakeMode) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Note: Picture-in-Picture needs no permission, and the app declares no
         <service> — the unused FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PLAYBACK
         permissions were removed (no Service/MediaSessionService exists). -->

    <!-- Download Manager: storage access (scoped on API 29+) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Download notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declare that the app supports Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PishiMovie"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!-- Main activity for mobile/tablet and TV -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PishiMovie"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VideoPlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.PishiMovie.FullScreen"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:hardwareAccelerated="true" />

        <!-- Subtitle Settings — launched from the player (per-video mode)
             and from Settings → Playback → Subtitle Settings (global mode).
             Uses the standard PishiMovie theme (no fullscreen). -->
        <activity
            android:name=".SubtitleSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PishiMovie"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/subtitle_settings"
            android:hardwareAccelerated="true" />
    </application>

</manifest>
